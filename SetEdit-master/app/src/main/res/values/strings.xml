    <!-- Wireless debugging connection -->
    <string name="connect_title">Connect to this device</string>
    <string name="connect_intro">SetEdit can use this device\'s own ADB (wireless debugging) to edit every settings table — no root and no extra app. You only need to connect once.</string>
    <string name="connect_steps">1. Open Developer options and turn on Wireless debugging.\n2. Tap “Pair device with pairing code”.\n3. Keep that dialog open and tap Connect below.</string>
