    <!-- Onboarding -->
    <string name="onboard_title_1">Welcome to SetEdit</string>
    <string name="onboard_body_1">Read and edit the hidden system, secure and global settings tables on your device — with a clean, modern interface.</string>
    <string name="onboard_title_2">Grant access once</string>
    <string name="onboard_body_2">Android 15 and later hide most settings from apps. SetEdit uses root, Shizuku or a one-time wireless-debugging connection to reach them. You only have to do this once.</string>
    <string name="onboard_title_3">Works offline</string>
    <string name="onboard_body_3">After that one-time connection, SetEdit keeps working with no Wi-Fi and no internet. Everything you change is applied on-device.</string>
